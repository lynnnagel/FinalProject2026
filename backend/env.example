# ---------------------------------------------------------------------------
# LURA – משתני סביבה
# העתק קובץ זה ל-.env באותה תיקייה, ומלא את הערכים.
#   Windows:  copy env.example .env
#   Linux:    cp env.example .env
#
# .env אינו נכלל במאגר (ראה .gitignore) מכיוון שהוא מכיל סודות.
# ---------------------------------------------------------------------------

# חובה. חותם את אסימוני ההתחברות (JWT). ללא ערך השרת לא יעלה.
# צור מפתח:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# כתובת הבסיס שממנה נבנים קישורים שנשלחים במייל (איפוס סיסמה וכו')
APP_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# שליחת מיילים (התראות מפקח + איפוס סיסמה)
# SMTP_PASSWORD הוא App Password של Gmail — לא הסיסמה הרגילה.
# ליצירה: https://myaccount.google.com/apppasswords
# ---------------------------------------------------------------------------
EMAIL_ENABLED=true
SMTP_USER=your-lura-email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=LURA
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ---------------------------------------------------------------------------
# מסד נתונים
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./lura.db

# ---------------------------------------------------------------------------
# כיול הניקוד  (ראה backend/scoring.py)
#     score = max( bert·damping + RULE_BOOST·rules ,  rules )
#
# שינוי בערכים כאן פוסל אוטומטית תוצאות סריקה שנשמרו לפניו, והן
# מחושבות מחדש — ראה SCORING_VERSION ב-config.py.
#
# לכיול מחדש:  python ML/calibrate.py  ואחריו  python ML/sanity_check.py
# ---------------------------------------------------------------------------
RULE_BOOST=0.5
TRUST_DAMPING=0.25
PROMO_DAMPING=0.30

# ---------------------------------------------------------------------------
# מודל BERT
# החלפת מודל מחייבת אימון מחדש — checkpoint של אחד אינו תואם לשני.
#   bert-base-multilingual-cased        177M · ~710 MB · דיוק בסיס
#   distilbert-base-multilingual-cased  135M · ~540 MB · פי ~2 מהיר
# BERT_QUANTIZE מפעיל int8 בזמן טעינה: פחות זיכרון והרצה מהירה על CPU.
# ---------------------------------------------------------------------------
BERT_MODEL_NAME=bert-base-multilingual-cased
BERT_QUANTIZE=false
BERT_MAX_LENGTH=256
