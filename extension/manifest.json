{
  "manifest_version": 3,
  "name": "LURA - הגנת פישינג חכמה",
  "version": "1.0.0",
  "description": "זיהוי פישינג בזמן אמת עם מערכת ניטור הורים",
  "permissions": [
    "activeTab",
    "storage",
    "notifications",
    "alarms",
    "contextMenus",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "http://localhost/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },

    "web_accessible_resources": [
    {
      "resources": ["icons/icon128.png", "icons/icon128.png"],
      "matches": ["https://mail.google.com/*", "https://outlook.live.com/*"]
    }
  ]
}
